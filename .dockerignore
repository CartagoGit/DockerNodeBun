# Excluir todo lo que el Dockerfile NO necesita.
# El Dockerfile copia ficheros concretos de scripts/ (helpers NodeBun).
# El resto del repo es ruido en el contexto.

# VCS
.git
.gitignore
.gitattributes

# Configuracion local / IDEs
.vscode
.idea

# Documentacion (no se copia a la imagen)
*.md
LICENSE

# CI de GitHub (workflows corre en GH Actions, no dentro de la imagen)
.github

# Backups / OS dentro de scripts/ (el Dockerfile COPY es selectivo).
scripts/.DS_Store
scripts/*.swp

# Logs / temp
*.log
*.tmp
.DS_Store
Thumbs.db