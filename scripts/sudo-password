#!/bin/sh
# Enable (or change) a sudo password for login users in this container.
# Usage:
#   sudo-password                 # prompt (hidden)
#   sudo-password 'secret'        # from arg (visible in process list)
#   SUDO_PASSWORD=secret sudo-password
# Requires root, or current NOPASSWD sudo to bootstrap.
set -eu

if [ "$(id -u)" -ne 0 ]; then
  if command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1; then
    exec sudo -n "$0" "$@"
  fi
  echo "sudo-password: need root (or passwordless sudo to bootstrap)" >&2
  exit 1
fi

password="${1:-${SUDO_PASSWORD:-}}"
if [ -z "$password" ]; then
  if [ -t 0 ]; then
    printf 'New sudo password: ' >&2
    stty -echo
    IFS= read -r password
    stty echo
    printf '\n' >&2
  else
    echo "sudo-password: no password given (arg, SUDO_PASSWORD, or tty)" >&2
    exit 2
  fi
fi
if [ -z "$password" ]; then
  echo "sudo-password: empty password; use sudo-nopasswd instead" >&2
  exit 2
fi

umask 077
printf '%s\n' "$password" > /etc/nodebun-sudo-password
chmod 0400 /etc/nodebun-sudo-password

printf '%s\n' \
  'Defaults !requiretty' \
  'Defaults lecture=never' \
  'Defaults secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/share/bun/bin:/usr/share/fnm/bin"' \
  'ALL ALL=(ALL:ALL) ALL' \
  > /etc/sudoers.d/nodebun-password
chmod 0440 /etc/sudoers.d/nodebun-password
visudo -cf /etc/sudoers.d/nodebun-password
rm -f /etc/sudoers.d/nodebun

awk -F: '$3>=0 && $3<65534 && $7 !~ /(nologin|false)/ {print $1}' /etc/passwd \
  | while read -r u; do
      usermod -aG sudo "$u" 2>/dev/null || true
      printf '%s\n' "${u}:${password}" | chpasswd
    done

touch /run/nodebun-sudo-password-applied 2>/dev/null || true
echo "sudo-password: password required for sudo (group sudo)" >&2
