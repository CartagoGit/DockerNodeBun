#!/bin/sh
# Drop the optional sudo password and restore NOPASSWD (image default).
set -eu

if [ "$(id -u)" -ne 0 ]; then
  if command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1; then
    exec sudo -n "$0" "$@"
  fi
  if command -v sudo >/dev/null 2>&1; then
    exec sudo "$0" "$@"
  fi
  echo "sudo-nopasswd: need root (or sudo with the current password)" >&2
  exit 1
fi

printf '%s\n' \
  'Defaults !requiretty' \
  'Defaults lecture=never' \
  'Defaults secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/share/bun/bin:/usr/share/fnm/bin"' \
  'ALL ALL=(ALL:ALL) NOPASSWD:ALL' \
  > /etc/sudoers.d/nodebun
chmod 0440 /etc/sudoers.d/nodebun
visudo -cf /etc/sudoers.d/nodebun
rm -f /etc/sudoers.d/nodebun-password /etc/nodebun-sudo-password /run/nodebun-sudo-password-applied

echo "sudo-nopasswd: sudo is passwordless again" >&2
